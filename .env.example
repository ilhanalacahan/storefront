# StoreFront — ortam değişkenleri şablonu.
# Kopyalayın: cp .env.example .env.local

# TicariCore backend kökü (sunucu tarafı — tarayıcıya sızmaz).
# Yerel geliştirme: TicariCore :6210'da çalışır (make run-backend).
TICARICORE_URL=http://localhost:6210

# Satış kanalının publishable key'i — bu site HANGİ kanalın vitrini, onu söyler.
# TicariApp → Satış Kanalları → kanal detayında görünür/kopyalanır.
# Biçim: pk_{tenant}_{32hex}. Gizli DEĞİLDİR ama yine de sunucu tarafında tutulur;
# tarayıcı istekleri /api/store proxy'sinden geçer (CORS ayarı da gerekmez).
TICARICORE_PUBLISHABLE_KEY=pk_tenant1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vitrin adı — başlık ve logoda kullanılır.
NEXT_PUBLIC_SITE_NAME=StoreFront

# --- Satıcı künyesi (yasal metinler) ---
# Mesafeli Sözleşmeler Yönetmeliği bu bilgileri sözleşmede ZORUNLU kılar.
# Boş bırakılırsa /sozlesmeler sayfaları "yayına hazır değil" uyarısı gösterir.
# Tamamı sözleşme sayfasında zaten kamuya açık yayımlanır; gizli değildir.
NEXT_PUBLIC_SATICI_UNVAN=Örnek Ticaret A.Ş.
NEXT_PUBLIC_SATICI_ADRES=Örnek Mah. Örnek Cad. No:1, Kadıköy/İstanbul
NEXT_PUBLIC_SATICI_TELEFON=0850 000 00 00
NEXT_PUBLIC_SATICI_EPOSTA=destek@ornek.com
NEXT_PUBLIC_SATICI_MERSIS=0000000000000000
NEXT_PUBLIC_SATICI_VERGI=Kadıköy V.D. / 0000000000
# İade adresi merkez adresten farklıysa doldurun; boşsa NEXT_PUBLIC_SATICI_ADRES kullanılır.
NEXT_PUBLIC_SATICI_IADE_ADRESI=

# --- SEO ---
# Sitenin kamusal kökü. sitemap.xml, canonical ve Open Graph görselleri MUTLAK
# adres ister; tanımsızsa localhost kullanılır (geliştirmede doğru davranış).
NEXT_PUBLIC_SITE_URL=https://magazaniz.com
